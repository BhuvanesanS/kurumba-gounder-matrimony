# Copy this file to .env locally. Do not commit .env or share your password.
# Replace YOUR_POSTGRES_PASSWORD with the password you selected during PostgreSQL installation.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/kurumba_gounder_matrimony

# Required for the existing local server and Super Admin area.
CONTACT_ENCRYPTION_KEY=replace-with-a-long-random-local-secret
SUPER_ADMIN_TOKEN=replace-with-a-long-random-admin-token
